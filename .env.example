APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

OLLAMA_BASE_URL=http://localhost:11434
ARCHITECT_MODEL=gemma4:12b     # CUSTOMIZE after running scripts/spike_ollama.py / ollama list
SPECIALIST_MODEL=gemma4:12b    # CUSTOMIZE
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_KEEP_ALIVE=30m
LLM_ENVELOPE_RETRIES=1

DATA_DIR=./data                # relative paths resolve against the repo root
UPLOAD_DIR=./data/uploads
LANCEDB_URI=./data/lancedb
MANIFESTS_DIR=./data/manifests
MAX_UPLOAD_MB=5

RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=3
RAG_SCORE_THRESHOLD=0.55       # PLACEHOLDER: set from scripts/calibrate_threshold.py
SCOPE_OUT_MIN=0.55             # PLACEHOLDER: calibrate
SCOPE_MARGIN=0.05              # PLACEHOLDER: calibrate
MAX_REPAIR_ATTEMPTS=2
SPECIALIST_MAX_TOOL_CALLS=2

VITE_API_BASE_URL=http://localhost:8000/api
