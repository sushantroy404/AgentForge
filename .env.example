APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
DEMO_MODE=off                  # off | replay | auto (auto = replay when Ollama is down)

OLLAMA_BASE_URL=http://localhost:11434
ARCHITECT_MODEL=gemma4:12b
SPECIALIST_MODEL=gemma4:12b
EMBEDDING_MODEL=bge-m3
OLLAMA_NUM_CTX=4096          # keeps VRAM usage low on 8 GB; make it easy to raise
OLLAMA_TIMEOUT_SECONDS=120   # the model may be partly on CPU, so replies can be slow
OLLAMA_KEEP_ALIVE=30m        # avoid reloading the model on every chat
LLM_ENVELOPE_RETRIES=1

DATA_DIR=./data                # relative paths resolve against the repo root
UPLOAD_DIR=./data/uploads
LANCEDB_URI=./data/lancedb
MANIFESTS_DIR=./data/manifests
MAX_UPLOAD_MB=5

RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=3
# Calibrated thresholds for bge-m3 (from scripts/calibrate_threshold.py)
RAG_SCORE_THRESHOLD=0.50
RAG_SCORE_THRESHOLD_EN=0.52
RAG_SCORE_THRESHOLD_NE=0.53
RAG_SCORE_THRESHOLD_NE_ROMAN=0.45

SCOPE_OUT_MIN=0.35
SCOPE_OUT_MIN_EN=0.50
SCOPE_OUT_MIN_NE=0.35
SCOPE_OUT_MIN_NE_ROMAN=0.39

SCOPE_MARGIN=0.03
SCOPE_MARGIN_EN=0.06
SCOPE_MARGIN_NE=0.03
SCOPE_MARGIN_NE_ROMAN=0.03

MAX_REPAIR_ATTEMPTS=2
SPECIALIST_MAX_TOOL_CALLS=2

# Query rewriting for Roman Nepali (switchable on | off)
QUERY_REWRITE=on

# Memory reduction limits (configured for 8 GB VRAM)
MAX_HISTORY_TURNS=3            # number of chat turns (user+assistant pairs) sent to models
RAG_MAX_CHUNK_CHARS=400        # maximum characters per retrieved chunk in LLM prompt

# Language detection optional LLM fallback (keep off by default on low VRAM)
LANG_DETECT_LLM_FALLBACK=off   # on | off (calls model for borderline/uncertain language classification)

VITE_API_BASE_URL=http://localhost:8000/api

